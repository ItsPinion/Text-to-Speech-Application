# ── API (apps/api) ────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
TTS_PROVIDER=edge-tts          # edge-tts (default) | mock (offline/tests)
# Free AI (Phases 12–13). All optional: without a key the AI feature is disabled
# (503 AI_NOT_CONFIGURED) and the rest of the app works (constraint C2).
AI_BASE_URL=                   # e.g. https://openrouter.ai/api/v1 (free tier) or http://localhost:11434/v1 (Ollama)
AI_API_KEY=                    # user-supplied FREE-tier key — never commit
AI_MODEL=                      # e.g. a ":free" OpenRouter model, a Groq free model, or a local Ollama name
# Clerk (Phase 14)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Turso / libSQL (Phase 15)
TURSO_DB_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# ── Web (apps/web) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
