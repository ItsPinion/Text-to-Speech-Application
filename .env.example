# Copy the server block to apps/server/.env for local development.
# NEVER commit real keys — .env is git-ignored (Phase 0, test 0.2).

# ── Server (apps/server) ─────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Origin allowed by CORS during development (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
# "mock" = fixture audio, no key needed (CI default). "google" = real speech
# via Google Cloud TTS — requires TTS_API_KEY below (Phase 5).
TTS_PROVIDER=mock
# Blank on purpose — fill in locally only, never commit. Server-side ONLY:
# it must never appear in the client bundle (Phase 5 test 5.6).
TTS_API_KEY=
TTS_REGION=
# Vendor request timeout in ms (Phase 5; overdue requests become 503s).
TTS_TIMEOUT_MS=30000
# Phase 7: JWT signing secret for login tokens (REQUIRED in production).
JWT_SECRET=
# Phase 7: SQLite file for users/generations/favorites. :memory: for tests.
DB_PATH=

# ── Client (apps/client) ─────────────────────────────────────────
# Leave blank in dev: Vite proxies /api to http://localhost:3000.
# Set to the absolute API origin in production (Phase 9).
VITE_API_URL=
