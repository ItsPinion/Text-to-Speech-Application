# ── Text-to-Speech Platform — environment template ─────────────────────
# Copy to .env and fill in real values. NEVER commit the real .env.
#   cp .env.example .env

# ── server/ ────────────────────────────────────────────────────────────
# Port the Express API listens on (Vite dev proxy targets this)
PORT=3000

# TTS provider selection:
#   mock   — default; fixture beep; zero cost; used by CI and npm test
#   espeak — REAL speech, 100% offline (eSpeak-NG via WASM): no key, no
#            account, no network, no billing — works everywhere
#   google — neural speech via Google Cloud TTS (needs TTS_API_KEY)
TTS_PROVIDER=mock

# Google Cloud API key — ONLY used when TTS_PROVIDER=google.
# Create one in Google Cloud Console (enable "Cloud Text-to-Speech API").
# Server-side only: never sent to the browser, never logged, never in git.
TTS_API_KEY=

# Vendor call timeout in ms (default 30000)
TTS_TIMEOUT_MS=30000

# CORS allowlist — comma-separated browser origins allowed to call the API
# (Phase 6). Origins not on this list get no CORS headers (browsers block).
# In dev the Vite proxy makes traffic same-origin, so the default just works.
CLIENT_ORIGIN=http://localhost:5173

# Rate limit overrides (defaults: 10 requests / 15 min / IP, per the contract)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MINUTES=15

# Auth (Phase 7): secret for signing JWTs. Set a long random string in
# production (openssl rand -hex 32). Blank in dev = random per-process
# secret (tokens reset on restart).
JWT_SECRET=

# JWT lifetime in hours (default 24)
# TOKEN_TTL_HOURS=24

# SQLite database file (default: server/data/tts.db; tests use :memory:)
# DB_PATH=

# Request logging: on by default in dev/production (one JSON line per request;
# user text is logged as LENGTH only). Set 0 to silence.
# LOG_REQUESTS=1

# ── client/ (Vite) ─────────────────────────────────────────────────────
# Not needed in dev (Vite proxies /api). Set for production builds later.
# VITE_API_URL=
