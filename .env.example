# ============================================================
# Text-to-Speech Platform — environment template
# Copy to `.env` and fill in values. NEVER commit a real .env.
# Keys live ONLY on the server (see docs/API.md — frozen contract).
# ============================================================

# ---------- Server ----------
# Port the Express API listens on
PORT=3000
# development | production | test
NODE_ENV=development
# Browser origin allowed by CORS (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# ---------- TTS provider (used from Phase 5 onward) ----------
# `mock` = tiny fixture beep, no key, no billing (default for CI & early phases)
TTS_PROVIDER=mock
# Real vendor key (Google / Azure / Polly / ElevenLabs). Server-side ONLY —
# this value must NEVER appear in the client bundle. Leave blank until Phase 5.
TTS_API_KEY=
# Vendor region, if the chosen provider needs one (e.g. Azure)
TTS_REGION=

# ---------- Client ----------
# Absolute base URL of the API in production (leave blank in dev —
# the Vite dev server proxies /api -> http://localhost:3000)
VITE_API_URL=
