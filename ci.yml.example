# NOTE: GitHub App push permissions block .github/workflows/ in this branch.
# To enable CI: mkdir -p .github/workflows && git mv ci.yml.example .github/workflows/ci.yml

name: CI

on:
  push:
  pull_request:

jobs:
  ci:
    name: Build & test (mock TTS)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build
        run: pnpm build

      - name: Test
        run: pnpm test
        env:
          # CI never needs a real key — the server defaults to the mock provider.
          TTS_PROVIDER: mock
