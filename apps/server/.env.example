# Local server environment — copy to apps/server/.env (git-ignored).
PORT=3000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
# "mock" needs no key; "google" = real speech via Google Cloud TTS (needs TTS_API_KEY).
TTS_PROVIDER=mock
# Blank on purpose — fill locally, never commit (Phase 0 test 0.2).
TTS_API_KEY=
TTS_REGION=
# Vendor request timeout in ms (Phase 5; overdue requests become 503s).
TTS_TIMEOUT_MS=30000

# ── Phase 7: auth, history, favorites ──────────────────────────────
# REQUIRED in production — signs login tokens. Long random string.
JWT_SECRET=
# SQLite database file ("node:sqlite", zero deps). Use :memory: for tests.
DB_PATH=
# Generated-audio storage for history replay.
UPLOADS_DIR=

# ── IndexTTS provider (LOCAL, FREE — no key, no credit card) ────────
# Start the sidecar with: docker compose up indextts  (see sidecar/README.md)
# Then set TTS_PROVIDER=indextts above.
# INDEX_TTS_API_URL=http://127.0.0.1:7861
# INDEX_TTS_TIMEOUT_MS=120000
