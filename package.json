{
  "name": "text-to-speech",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "lint": "turbo run lint",
    "lint:staged": "bash scripts/lint-staged.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:network": "turbo run test:network"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
