{
  "name": "text-to-speech-application",
  "version": "0.4.0",
  "private": true,
  "description": "Text-to-Speech Platform — Turborepo monorepo: Express API + React (Vite) client",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "turbo run dev",
    "dev:server": "npm run dev -w tts-server",
    "dev:client": "npm run dev -w tts-client",
    "build": "turbo run build",
    "start": "npm run start -w tts-server",
    "test": "turbo run test",
    "test:server": "npm run test -w tts-server",
    "test:client": "npm run test -w tts-client"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.8"
}
