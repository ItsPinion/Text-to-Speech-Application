{
  "name": "text-to-speech",
  "version": "0.1.0",
  "private": true,
  "description": "TTS://TERMINAL — text-to-speech platform (monorepo: Express API + React UI, bun-managed)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "bash start.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "dev:server": "turbo run dev --filter=@tts/server",
    "dev:client": "turbo run dev --filter=@tts/client",
    "fixtures": "bun --cwd apps/server run generate:fixtures"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
