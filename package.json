{
  "name": "text-to-speech",
  "version": "0.1.0",
  "private": true,
  "description": "TTS://TERMINAL — text-to-speech platform (Turborepo: Express API + React UI)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "dev:server": "turbo run dev --filter=@tts/server",
    "dev:client": "turbo run dev --filter=@tts/client"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
